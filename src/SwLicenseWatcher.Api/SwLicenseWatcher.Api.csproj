<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <DefineConstants Condition="'$(PublishAot)' == 'true'">$(DefineConstants);NATIVE_AOT</DefineConstants>
    <AspNetCoreHostingModel Condition="'$(PublishAot)' != 'true'">InProcess</AspNetCoreHostingModel>
    <UseAppHost Condition="'$(PublishAot)' != 'true'">false</UseAppHost>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\admin\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Non-AOT flavour (IIS publish, test references) gets its own bin/obj. See NonAotFlavour.props. -->
  <Import Project="..\..\NonAotFlavour.props" Condition="'$(PublishAot)' != 'true'" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference
      Include="..\SwLicenseWatcher.Application\SwLicenseWatcher.Application.csproj"
      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\SwLicenseWatcher.Core\SwLicenseWatcher.Core.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\SwLicenseWatcher.Crypto\SwLicenseWatcher.Crypto.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference
      Include="..\SwLicenseWatcher.Infrastructure\SwLicenseWatcher.Infrastructure.csproj"
      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SwLicenseWatcher.Api.Tests" />
  </ItemGroup>

  <Target Name="PublishAdminWasmIntoWwwroot"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(PublishDir)' != ''">
    <PropertyGroup>
      <_AdminPublishDir>$(MSBuildThisFileDirectory)obj\$(Configuration)\admin-wasm\</_AdminPublishDir>
      <_PublishedAdminDir>$(PublishDir)wwwroot\admin\</_PublishedAdminDir>
    </PropertyGroup>
    <MSBuild Projects="..\SwLicenseWatcher.Admin\SwLicenseWatcher.Admin.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_AdminPublishDir);PublishAot=false;PublishTrimmed=false;SelfContained=false;RuntimeIdentifier=browser-wasm;UseAppHost=false;AdminInnerPublish=true"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
    <ItemGroup>
      <_AdminPublished Include="$(_AdminPublishDir)wwwroot\admin\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(_PublishedAdminDir)" />
    <Copy SourceFiles="@(_AdminPublished)"
          DestinationFiles="@(_AdminPublished->'$(_PublishedAdminDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Content Update="web.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
