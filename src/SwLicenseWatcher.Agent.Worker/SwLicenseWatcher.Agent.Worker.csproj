<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <!-- Non-AOT flavour (test references) gets its own bin/obj. See NonAotFlavour.props. -->
  <Import Project="..\..\NonAotFlavour.props" Condition="'$(PublishAot)' != 'true'" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwLicenseWatcher.Core\SwLicenseWatcher.Core.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\SwLicenseWatcher.Crypto\SwLicenseWatcher.Crypto.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SwLicenseWatcher.Agent.Worker.Tests" />
  </ItemGroup>

  <Target Name="PublishToastBesideWorker"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(PublishDir)' != ''">
    <PropertyGroup>
      <_ToastPublishDir>$(PublishDir)toast\</_ToastPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\SwLicenseWatcher.Agent.Toast\SwLicenseWatcher.Agent.Toast.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(_ToastPublishDir);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;PublishAot=false;PublishTrimmed=false;UseAppHost=true"
             RemoveProperties="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained" />
  </Target>
</Project>
