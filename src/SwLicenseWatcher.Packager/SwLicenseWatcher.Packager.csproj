<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>SwLicenseWatcher.Packager</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <Import Project="..\..\NonAotFlavour.props" Condition="'$(PublishAot)' == 'false'" />

  <ItemGroup>
    <ProjectReference Include="..\SwLicenseWatcher.Setup.Core\SwLicenseWatcher.Setup.Core.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed" />
  </ItemGroup>

</Project>
