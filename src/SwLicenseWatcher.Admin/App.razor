@using SwLicenseWatcher.Admin.Components

@if (!_ready)
{
    <p class="hint loading-msg">불러오는 중...</p>
}
else
{
    <header class="top">
        <div>
            <h1>소프트웨어 라이선스 감시</h1>
            <p class="@_statusClass">@_statusLine</p>
        </div>
        @if (_hasToken)
        {
            <div class="header-actions">
                <div class="auto-refresh">
                    <div class="auto-refresh-row">
                        <span class="auto-refresh-label">자동 새로고침 (5분)</span>
                        <button type="button"
                                class="switch @(_autoRefresh ? "is-on" : null)"
                                role="switch"
                                aria-checked="@_autoRefresh.ToString().ToLowerInvariant()"
                                aria-label="자동 새로고침 5분"
                                @onclick="ToggleAutoRefreshAsync">
                            <span class="switch-thumb"></span>
                        </button>
                    </div>
                    <p class="auto-refresh-hint">@AutoRefreshHint</p>
                </div>
                <button type="button" class="logout" @onclick="LogoutAsync">로그아웃</button>
            </div>
        }
    </header>

    @if (!_hasToken)
    {
        <section class="card">
            <h2>관리자 토큰</h2>
            @if (!string.IsNullOrEmpty(_tokenError))
            {
                <p class="error">@_tokenError</p>
            }
            <div class="form-actions">
                <label>AdminToken
                    <input type="password" autocomplete="off" @bind="_tokenInput" @onkeydown="OnTokenKey" />
                </label>
                <button type="button" class="primary" @onclick="SaveTokenAsync">저장</button>
            </div>
            <p class="hint">토큰은 이 브라우저 탭의 sessionStorage에만 저장됩니다.</p>
        </section>
    }
    else
    {
        <section class="app-panel">
            <nav class="tabs">
                <button type="button" class="tab @(_tabs.IsActive("devices") ? "is-active" : null)" @onclick="@(() => SelectTab("devices"))">PC 목록</button>
                <button type="button" class="tab @(_tabs.IsActive("software") ? "is-active" : null)" @onclick="@(() => SelectTab("software"))">소프트웨어</button>
                <button type="button" class="tab @(_tabs.IsActive("violations") ? "is-active" : null)" @onclick="@(() => SelectTab("violations"))">위반</button>
                <button type="button" class="tab @(_tabs.IsActive("policies") ? "is-active" : null)" @onclick="@(() => SelectTab("policies"))">정책</button>
                <button type="button" class="tab @(_tabs.IsActive("uninstall") ? "is-active" : null)" @onclick="@(() => SelectTab("uninstall"))">제거 요청</button>
                <button type="button" class="tab @(_tabs.IsActive("updates") ? "is-active" : null)" @onclick="@(() => SelectTab("updates"))">업데이트</button>
            </nav>

            @if (_tabs.IsVisited("devices"))
            {
                <div hidden="@(!_tabs.IsActive("devices"))">
                    <DevicesTab @ref="_devicesTab" Refreshed="OnRefreshed" />
                </div>
            }
            @if (_tabs.IsVisited("software"))
            {
                <div hidden="@(!_tabs.IsActive("software"))">
                    <SoftwareTab @ref="_softwareTab" Refreshed="OnRefreshed" />
                </div>
            }
            @if (_tabs.IsVisited("violations"))
            {
                <div hidden="@(!_tabs.IsActive("violations"))">
                    <ViolationsTab @ref="_violationsTab" Refreshed="OnRefreshed" />
                </div>
            }
            @if (_tabs.IsVisited("policies"))
            {
                <div hidden="@(!_tabs.IsActive("policies"))">
                    <PoliciesTab @ref="_policiesTab" Refreshed="OnRefreshed" />
                </div>
            }
            @if (_tabs.IsVisited("uninstall"))
            {
                <div hidden="@(!_tabs.IsActive("uninstall"))">
                    <UninstallTab @ref="_uninstallTab" Refreshed="OnRefreshed" />
                </div>
            }
            @if (_tabs.IsVisited("updates"))
            {
                <div hidden="@(!_tabs.IsActive("updates"))">
                    <UpdatesTab @ref="_updatesTab" Refreshed="OnRefreshed" />
                </div>
            }
        </section>
        <DetailDrawer Changed="OnDrawerChangedAsync" />
    }
}
