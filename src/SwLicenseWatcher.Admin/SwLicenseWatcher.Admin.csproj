<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly" TreatAsLocalProperty="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>admin</StaticWebAssetBasePath>
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <!-- Solution restore/publish pass -r win-x64 for Native AOT. Browser WASM has no such pack. -->
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <ProjectReference Include="..\SwLicenseWatcher.Core\SwLicenseWatcher.Core.csproj" AdditionalProperties="PublishAot=false;PublishTrimmed=false" />
  </ItemGroup>

  <Target Name="CopyWasmToApiWwwroot" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(AdminInnerPublish)' != 'true'">
    <PropertyGroup>
      <_ApiAdminDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\SwLicenseWatcher.Api\wwwroot\admin'))</_ApiAdminDir>
    </PropertyGroup>
    <ItemGroup>
      <_AdminStatic Include="$(MSBuildThisFileDirectory)wwwroot\**\*.*" />
      <_AdminFramework Include="$(OutputPath)wwwroot\_framework\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(_ApiAdminDir)" />
    <Copy SourceFiles="@(_AdminStatic)" DestinationFiles="@(_AdminStatic->'$(_ApiAdminDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AdminFramework)" DestinationFiles="@(_AdminFramework->'$(_ApiAdminDir)\_framework\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
