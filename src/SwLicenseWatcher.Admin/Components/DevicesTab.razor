@inherits AdminTabComponent
@using static DashboardPresentation
@inject IJSRuntime Js

<div class="toolbar">
    <label>검색
        <input type="search" maxlength="256" @bind="Search" @bind:event="oninput" @onkeydown="OnSearchKey" />
    </label>
    <label>지연(시간)
        <input type="number" min="1" step="1" @bind="_staleHours" />
    </label>
    <button type="button" class="primary" @onclick="QueryAsync">조회</button>
    <button type="button" @onclick="BroadcastAsync">전체 PC에 알림 보내기</button>
    <button type="button" @onclick="@(() => DownloadCsvAsync("/api/inventory/devices", "devices.csv"))">CSV 다운로드</button>
</div>
@if (_broadcastOpen)
{
    <div class="toolbar stack">
        <label>알림 제목
            <input maxlength="128" @bind="_broadcastTitle" />
        </label>
        <label>알림 본문
            <input maxlength="1024" @bind="_broadcastBody" />
        </label>
        <button type="button" class="primary" @onclick="SendBroadcastAsync">보내기</button>
        <button type="button" @onclick="() => _broadcastOpen = false">취소</button>
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <p class="error">@Error</p>
}
<p class="meta">@Meta</p>

<table class="data">
    <thead><tr><th>자산코드</th><th>PC 명</th><th>도메인</th><th>OS</th><th>에이전트</th><th>heartbeat</th><th>inventory</th></tr></thead>
    <tbody>
        @if (_devices.Count == 0)
        {
            <tr><td class="empty" colspan="7">항목이 없습니다.</td></tr>
        }
        else
        {
            @foreach (var row in _devices)
            {
                <tr>
                    <td><button type="button" class="linkish" @onclick="@(() => Drawer.OpenDeviceAsync(row.DeviceCode))">@Dash(row.DeviceCode)</button></td>
                    <td><button type="button" class="linkish" @onclick="@(() => Drawer.OpenDeviceAsync(row.DeviceCode))">@Dash(PcName(row.HostName, row.AssignedHostName))</button></td><td>@Dash(row.DomainName)</td><td>@Dash(row.OperatingSystem)</td>
                    <td>@Dash(row.AgentVersion)</td><td>@FormatTime(row.LastHeartbeatUtc)</td><td>@FormatTime(row.LastInventoryUtc)</td>
                </tr>
            }
        }
    </tbody>
</table>
<Pagination From="PageFrom" To="PageTo" Total="TotalCount" CanPrev="CanPrev" CanNext="CanNext"
            Previous="PrevPageAsync" Next="NextPageAsync" />

@code {
    private string _staleHours = "";
    private bool _broadcastOpen;
    private string _broadcastTitle = "";
    private string _broadcastBody = "";
    private IReadOnlyList<DeviceSummary> _devices = [];

    public override async Task RefreshAsync()
    {
        await LoadAsync(async () =>
        {
            var data = await Api.GetDevicesAsync(PagingQuery());
            _devices = data.Items ?? [];
            TotalCount = data.TotalCount;
        });
        if (Drawer.IsOpen)
        {
            await Drawer.RefreshAsync();
        }
    }

    protected override void AddFilters(List<string> parts)
    {
        if (!string.IsNullOrWhiteSpace(_staleHours))
        {
            parts.Add("staleAfterHours=" + Uri.EscapeDataString(_staleHours.Trim()));
        }
    }

    private void BroadcastAsync()
    {
        _broadcastOpen = true;
        Error = "";
    }

    private async Task SendBroadcastAsync()
    {
        if (!await Js.InvokeAsync<bool>("confirm", "등록된 모든 PC에 알림을 보낼까요? SSE가 붙은 PC는 바로, 아니면 다음 수집 주기에 표시됩니다."))
        {
            return;
        }

        Error = "";
        await Requests.RunAsync(async () =>
        {
            var result = await Api.BroadcastUserMessageAsync(new UserMessageWriteRequest(_broadcastTitle, _broadcastBody));
            Meta = $"{result.Count}대에 알림을 넣었습니다.";
            _broadcastOpen = false;
            _broadcastTitle = "";
            _broadcastBody = "";
        }, message => Error = message);
    }
}
