@using static DashboardPresentation
@implements IDisposable
@inject AdminApiClient Api
@inject AdminRequestHandler Requests
@inject DetailDrawerHost Host
@inject IJSRuntime Js

@if (_kind is not null)
{
    <div class="overlay" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
    <div class="backdrop" @onclick="Close"></div>
    <aside class="drawer">
        <div class="drawer-head">
            <h2 id="drawer-title">@_title</h2>
            <button type="button" @onclick="Close">닫기</button>
        </div>
        @if (_loading)
        {
            <p class="meta">불러오는 중...</p>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error">@_error</p>
        }
        <label class="drawer-class-wrap">분류
            <select @bind="_classFilter" @bind:after="RefreshAsync">
                @foreach (var value in SoftwareClasses)
                {
                    <option value="@value">@(value == "" ? "전체" : value)</option>
                }
            </select>
        </label>
        <div>
            @if (_kind == "device" && _device is { } detail)
            {
                <div class="drawer-form stack">
                    <label>자산코드
                        <input maxlength="128" @bind="_assignedDeviceCode" />
                    </label>
                    <label>PC 명
                        <input maxlength="128" @bind="_assignedHostName" />
                    </label>
                    <p class="meta">현장 보고 호스트 @Dash(detail.HostName)</p>
                    <p class="meta">기기 고유값 @Dash(detail.DeviceId)</p>
                    <p class="meta">설치 @FormatTime(detail.InstalledAtUtc)@if (detail.SupersededAtUtc is not null) { <text> · 이전 설치 @FormatTime(detail.SupersededAtUtc)</text> }</p>
                    <p>@Dash(detail.DomainName)</p>
                    <p class="meta">@Dash(detail.OperatingSystem) · 에이전트 @Dash(detail.AgentVersion)</p>
                    <p class="meta">heartbeat @FormatTime(detail.LastHeartbeatUtc) · inventory @FormatTime(detail.LastInventoryUtc)</p>
                    <label class="wide">메모
                        <textarea maxlength="1024" @bind="_deviceNotes"></textarea>
                    </label>
                    <p class="hint">자산코드와 PC 명은 다음 heartbeat/스냅샷 응답으로 클라이언트에 부여됩니다. 자산코드를 비우면 현장에서 넣은 임시값을 씁니다. 기기 고유값은 서버가 발급한 ML-DSA-87 인증서입니다. 원격 제거는 다음 heartbeat에서 Worker가 수행합니다. 사용자 알림은 SSE가 붙어 있으면 바로, 아니면 다음 수집(최대 약 20분)에 표시됩니다. 로그아웃 상태면 로그인 후에 뜹니다.</p>
                    <label>알림 제목
                        <input maxlength="128" @bind="_messageTitle" />
                    </label>
                    <label class="wide">알림 본문
                        <textarea maxlength="1024" @bind="_messageBody"></textarea>
                    </label>
                    <div class="row-actions">
                    <button type="button" class="primary" @onclick="SaveDeviceProfileAsync">자산코드·PC 명·메모 저장</button>
                    <button type="button" @onclick="SendUserMessageAsync">이 PC에 알림 보내기</button>
                    <button type="button" class="danger" @onclick="DirectUninstallAsync">원격 제거 지시</button>
                    <button type="button" class="danger" @onclick="DeleteDeviceAsync">DB에서 제거</button>
                    </div>
                    @if (_installations.Count > 1)
                    {
                        <fieldset class="stack">
                            <legend>같은 자산코드의 설치가 여러 건입니다. 제거할 설치를 선택하세요.</legend>
                            @foreach (var item in _installations)
                            {
                                <label>
                                    <input type="radio" name="delete-installation" checked="@(_deletePcId == item.PcId)" @onclick="@(() => _deletePcId = item.PcId)" />
                                    @Dash(item.DeviceCode) · @Dash(PcName(item.HostName, item.AssignedHostName)) · 설치 @FormatTime(item.InstalledAtUtc)
                                    @if (item.SupersededAtUtc is not null)
                                    {
                                        <span class="meta"> 이전 설치</span>
                                    }
                                </label>
                            }
                            <div class="row-actions">
                                <button type="button" class="danger" @onclick="ConfirmDeleteSelectedAsync">선택한 설치만 DB에서 제거</button>
                                <button type="button" @onclick="CancelDeleteChoice">취소</button>
                            </div>
                        </fieldset>
                    }
                </div>
                <table class="data">
                    <thead><tr><th>이름</th><th>버전</th><th>게시자</th><th>분류</th><th>라이선스</th><th>범위</th></tr></thead>
                    <tbody>
                        @if (detail.InstalledSoftware.Count == 0)
                        {
                            <tr><td class="empty" colspan="6">항목이 없습니다.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in detail.InstalledSoftware)
                            {
                                <tr>
                                    <td><button type="button" class="linkish" @onclick="@(() => OpenSoftwareAsync(row.Name, row.Classification, row.Publisher))">@Dash(row.Name)</button></td>
                                    <td>@Dash(row.Version)</td><td>@Dash(row.Publisher)</td>
                                    <td>@Dash(row.Classification)</td>
                                    <td>
                                        @if (row.Classification == SoftwarePolicyClassificationNames.Managed)
                                        {
                                            <select class="license-source" value="@row.LicenseSourceOverride" @onchange="@(e => SaveLicenseSourceAsync(detail.DeviceCode, row.Name, e.Value?.ToString()))">
                                                <option value="">기본값</option><option value="@LicenseSourceNames.Company">회사</option><option value="@LicenseSourceNames.Byo">BYO</option>
                                            </select>
                                        }
                                        else
                                        {
                                            @LicenseLabel(row.LicenseSource)
                                        }
                                    </td>
                                    <td>@Dash(row.DiscoveryScope)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else if (_kind == "software")
            {
                <div class="drawer-form stack">
                    <div class="drawer-form-row">
                        <label>분류
                            <select @bind="_classifyAs">
                                <option value="@SoftwarePolicyClassificationNames.White">white</option>
                                <option value="@SoftwarePolicyClassificationNames.Managed">managed</option>
                                <option value="@SoftwarePolicyClassificationNames.Black">black</option>
                            </select>
                        </label>
                        @if (_classifyAs == SoftwarePolicyClassificationNames.Managed)
                        {
                            <label>기본 라이선스
                                <select class="license-source" @bind="_license">
                                    <option value="">미지정</option><option value="@LicenseSourceNames.Company">회사</option><option value="@LicenseSourceNames.Byo">BYO</option>
                                </select>
                            </label>
                        }
                    </div>
                    <label class="wide">정책 이름
                        <input maxlength="256" @bind="_policyPattern" />
                    </label>
                    <label class="wide">메모
                        <textarea maxlength="1024" @bind="_softwareNotes"></textarea>
                    </label>
                    <p class="hint">이름을 그대로 두면 이 제품 전체에 적용됩니다. `*` `?` 또는 `re:`로 바꾸면 그 패턴의 정책으로 저장됩니다. 예: re:^알집 (10\.94|12\.13)$</p>
                    <button type="button" class="primary" @onclick="SaveClassificationAsync">분류·메모 저장</button>
                </div>
                <p class="meta">설치 PC @_softwareTotal 대</p>
                <table class="data">
                    <thead><tr><th>자산코드</th><th>PC 명</th><th>OS</th><th>버전</th><th>게시자</th><th>분류</th><th>라이선스</th></tr></thead>
                    <tbody>
                        @if (_softwareDevices.Count == 0)
                        {
                            <tr><td class="empty" colspan="7">항목이 없습니다.</td></tr>
                        }
                        else
                        {
                            @foreach (var row in _softwareDevices)
                            {
                                <tr>
                                    <td><button type="button" class="linkish" @onclick="@(() => OpenDeviceAsync(row.PcId))">@Dash(row.DeviceCode)</button></td>
                                    <td><button type="button" class="linkish" @onclick="@(() => OpenDeviceAsync(row.PcId))">@Dash(PcName(row.HostName, row.AssignedHostName))</button></td>
                                    <td>@Dash(row.OperatingSystem)</td>
                                    <td>@Dash(row.Version)</td><td>@Dash(row.Publisher)</td><td>@Dash(row.Classification)</td>
                                    <td>
                                        @if (row.Classification == SoftwarePolicyClassificationNames.Managed)
                                        {
                                            <select class="license-source" value="@row.LicenseSourceOverride" @onchange="@(e => SaveLicenseSourceAsync(row.DeviceCode, _key, e.Value?.ToString()))">
                                                <option value="">기본값</option><option value="@LicenseSourceNames.Company">회사</option><option value="@LicenseSourceNames.Byo">BYO</option>
                                            </select>
                                        }
                                        else
                                        {
                                            @LicenseLabel(row.LicenseSource)
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </aside>
    </div>
}

@code {
    [Parameter] public EventCallback Changed { get; set; }

    private string? _kind;
    private long _pcId;
    private long _deletePcId;
    private string _key = "";
    private string _title = "상세";
    private string _publisher = "";
    private string _classFilter = "";
    private string _classifyAs = SoftwarePolicyClassificationNames.Managed;
    private string _license = "";
    private string _error = "";
    private string _assignedHostName = "";
    private string _assignedDeviceCode = "";
    private string _deviceNotes = "";
    private string _messageTitle = "";
    private string _messageBody = "";
    private string _softwareNotes = "";
    private string _policyPattern = "";
    private DeviceDetail? _device;
    private IReadOnlyList<DeviceInstallation> _installations = [];
    private IReadOnlyList<SoftwareDevice> _softwareDevices = [];
    private int _softwareTotal;
    private bool _loading;

    public bool IsOpen => _kind is not null;

    protected override void OnInitialized()
    {
        Host.Attach(this);
    }

    public void Dispose()
    {
        Host.Detach(this);
    }

    public async Task OpenDeviceAsync(long pcId)
    {
        _kind = "device";
        _pcId = pcId;
        _key = "";
        _title = "상세";
        _classFilter = "";
        _error = "";
        _device = null;
        _installations = [];
        _deletePcId = 0;
        _loading = pcId > 0;
        await InvokeAsync(StateHasChanged);
        await RefreshAsync();
    }

    public async Task OpenSoftwareAsync(string name, string? classification = null, string? publisher = null)
    {
        _kind = "software";
        _key = name;
        _title = name;
        _policyPattern = name;
        _publisher = publisher ?? "";
        _classFilter = "";
        _classifyAs = SoftwarePolicyClassificationNames.TryParse(classification, out var parsed)
            ? SoftwarePolicyClassificationNames.ToStorage(parsed)
            : SoftwarePolicyClassificationNames.Managed;
        _license = "";
        _softwareNotes = "";
        _error = "";
        _softwareDevices = [];
        _softwareTotal = 0;
        _loading = true;
        await InvokeAsync(StateHasChanged);
        await LoadSoftwareAsync();
    }

    public Task OpenSoftwareAsync(SoftwareAggregate row) =>
        OpenSoftwareAsync(row.Name, row.Classification);

    public async Task RefreshAsync()
    {
        if (_kind is null)
        {
            return;
        }

        _error = "";
        if (_kind == "device" && _pcId <= 0)
        {
            _error = "이 PC 행에는 식별자가 없어 열 수 없습니다.";
            _loading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        await Requests.RunAsync(async () =>
        {
            if (_kind == "device")
            {
                _device = await Api.GetDeviceByIdAsync(_pcId, EmptyToNull(_classFilter));
                _key = _device.DeviceCode;
                _title = PcName(_device.HostName, _device.AssignedHostName);
                _assignedHostName = _device.AssignedHostName ?? "";
                _assignedDeviceCode = _device.AssignedDeviceCode ?? _device.DeviceCode;
                _deviceNotes = _device.AdminNotes ?? "";
            }
            else
            {
                var query = "take=100";
                if (!string.IsNullOrEmpty(_classFilter))
                {
                    query += "&classification=" + Uri.EscapeDataString(_classFilter);
                }

                var data = await Api.GetSoftwareDevicesAsync(_key, query);
                _softwareDevices = data.Items ?? [];
                _softwareTotal = data.TotalCount;
                if (string.IsNullOrEmpty(_publisher) && _softwareDevices.Count > 0)
                {
                    _publisher = _softwareDevices[0].Publisher ?? "";
                }
            }
        }, message => _error = message);
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Close()
    {
        _kind = null;
        _pcId = 0;
        _deletePcId = 0;
        _key = "";
        _device = null;
        _installations = [];
        _softwareDevices = [];
        _error = "";
        _loading = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadSoftwareAsync()
    {
        await RefreshAsync();
        await LoadPolicyDefaultAsync();
    }

    private async Task LoadPolicyDefaultAsync()
    {
        await Requests.RunAsync(async () =>
        {
            var data = await Api.GetPoliciesAsync("search=" + Uri.EscapeDataString(_key) + "&take=20");
            var match = data.Items?.FirstOrDefault(row =>
                string.Equals(row.ProductName, _key, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                _license = match.DefaultLicenseSource ?? "";
                _softwareNotes = match.Notes ?? "";
                _classifyAs = SoftwarePolicyClassificationNames.ToStorage(match.Classification);
            }
        }, _ => { });
    }

    private async Task SaveDeviceProfileAsync()
    {
        _error = "";
        var succeeded = await Requests.RunAsync(
            () => Api.PutDeviceProfileAsync(_key, new DeviceProfileWriteRequest(
                EmptyToNull(_assignedHostName),
                EmptyToNull(_deviceNotes),
                EmptyToNull(_assignedDeviceCode))),
            message => _error = message);
        if (succeeded)
        {
            await Changed.InvokeAsync();
            await RefreshAsync();
        }
    }

    private async Task DirectUninstallAsync()
    {
        _error = "";
        if (_device is not { } detail)
        {
            return;
        }

        if (!await Js.InvokeAsync<bool>("confirm", $"{detail.DeviceCode} 에이전트를 원격 제거할까요? 다음 heartbeat에서 서비스가 삭제됩니다."))
        {
            return;
        }

        var succeeded = await Requests.RunAsync(
            () => Api.CreateDirectedUninstallAsync(detail.DeviceCode),
            message => _error = message);
        if (succeeded)
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task DeleteDeviceAsync()
    {
        _error = "";
        _installations = [];
        if (_device is not { PcId: > 0 } detail)
        {
            _error = "이 PC 행에는 식별자가 없어 제거할 수 없습니다.";
            return;
        }

        List<DeviceInstallation> installations = [];
        var loaded = await Requests.RunAsync(async () =>
        {
            installations = await Api.GetDeviceInstallationsAsync(detail.PcId);
        }, message => _error = message);
        if (!loaded)
        {
            return;
        }

        if (installations.Count == 0 || installations.Any(item => item.PcId <= 0))
        {
            _error = "이 PC 행에는 식별자가 없어 제거할 수 없습니다.";
            return;
        }

        if (installations.Count == 1)
        {
            await ConfirmDeleteAsync(installations[0], othersRemain: false);
            return;
        }

        _installations = installations;
        _deletePcId = installations.Any(item => item.PcId == detail.PcId) ? detail.PcId : installations[0].PcId;
    }

    private void CancelDeleteChoice()
    {
        _installations = [];
        _deletePcId = 0;
    }

    private async Task ConfirmDeleteSelectedAsync()
    {
        var selected = _installations.FirstOrDefault(item => item.PcId == _deletePcId);
        if (selected is null || selected.PcId <= 0)
        {
            _error = "이 PC 행에는 식별자가 없어 제거할 수 없습니다.";
            return;
        }

        await ConfirmDeleteAsync(selected, othersRemain: true);
    }

    private async Task ConfirmDeleteAsync(DeviceInstallation installation, bool othersRemain)
    {
        if (installation.PcId <= 0)
        {
            _error = "이 PC 행에는 식별자가 없어 제거할 수 없습니다.";
            return;
        }

        var previous = installation.SupersededAtUtc is null ? "" : ", 이전 설치";
        var others = othersRemain ? " 같은 자산코드의 다른 설치는 남습니다." : "";
        var message = $"자산코드 {installation.DeviceCode}, PC {PcName(installation.HostName, installation.AssignedHostName)}, 설치 {FormatTime(installation.InstalledAtUtc)}{previous} 만 DB에서 제거합니다.{others} 이 작업은 되돌릴 수 없습니다.";
        if (!await Js.InvokeAsync<bool>("confirm", message))
        {
            return;
        }

        var succeeded = await Requests.RunAsync(
            () => Api.DeleteDeviceAsync(installation.PcId),
            message => _error = message);
        if (succeeded)
        {
            Close();
            await Changed.InvokeAsync();
        }
    }

    private async Task SendUserMessageAsync()
    {
        _error = "";
        if (_device is not { } detail)
        {
            return;
        }

        var succeeded = await Requests.RunAsync(
            () => Api.SendDeviceUserMessageAsync(detail.DeviceCode, new UserMessageWriteRequest(_messageTitle, _messageBody)),
            message => _error = message);
        if (succeeded)
        {
            _messageTitle = "";
            _messageBody = "";
            await Changed.InvokeAsync();
        }
    }

    private async Task SaveClassificationAsync()
    {
        _error = "";
        if (!SoftwarePolicyClassificationNames.TryParse(_classifyAs, out var classification))
        {
            _error = "분류를 선택하세요.";
            return;
        }

        var pattern = _policyPattern.Trim();
        if (string.IsNullOrEmpty(pattern))
        {
            _error = "정책 이름을 입력하세요.";
            return;
        }

        var succeeded = await Requests.RunAsync(async () =>
        {
            if (string.Equals(pattern, _key, StringComparison.OrdinalIgnoreCase))
            {
                await Api.PutClassificationAsync(_key, new SoftwareClassificationWriteRequest(
                    classification,
                    EmptyToNull(_publisher),
                    LicenseSourceNames.ForManagedPolicy(classification, EmptyToNull(_license)),
                    _softwareNotes ?? ""));
                return;
            }

            if (!SoftwarePolicyMatcher.IsPattern(pattern))
            {
                await Api.PutClassificationAsync(pattern, new SoftwareClassificationWriteRequest(
                    classification,
                    Publisher: null,
                    LicenseSourceNames.ForManagedPolicy(classification, EmptyToNull(_license)),
                    _softwareNotes ?? ""));
                return;
            }

            var request = new SoftwarePolicyWriteRequest(
                pattern,
                Publisher: null,
                VersionPattern: null,
                classification,
                EmptyToNull(_softwareNotes),
                Enabled: true,
                LicenseSourceNames.ForManagedPolicy(classification, EmptyToNull(_license)));
            var listed = await Api.GetPoliciesAsync("search=" + Uri.EscapeDataString(pattern) + "&take=50");
            var existing = listed.Items?.FirstOrDefault(row => string.Equals(row.ProductName, pattern, StringComparison.Ordinal));
            if (existing is null)
            {
                await Api.CreatePolicyAsync(request);
            }
            else
            {
                await Api.UpdatePolicyAsync(existing.Id, request);
            }
        }, message => _error = message);
        if (succeeded)
        {
            await Changed.InvokeAsync();
        }
    }

    private async Task SaveLicenseSourceAsync(string deviceCode, string softwareName, string? licenseSource)
    {
        _error = "";
        var succeeded = await Requests.RunAsync(
            () => Api.PutLicenseSourceAsync(deviceCode, softwareName, new(EmptyToNull(licenseSource))),
            message => _error = message);
        if (succeeded)
        {
            await Changed.InvokeAsync();
        }
    }
}
